<settings>
  <!--  add lineaje server configuration and credentials -->
  <servers>
    <server>
      <configuration>
        <httpConfiguration>
          <all>
            <usePreemptive>true</usePreemptive>
          </all>
        </httpConfiguration>
      </configuration>
      <id>lineaje-artifactory</id>
      <username>dylan@gladogmi.fr.nf</username>
      <password></password>
    </server>
  </servers>
  <!--  Tell the build tool to use this server for everything except plugins -->
  <mirrors>
    <mirror>
      <id>lineaje-fortknox-artifactory</id>
      <mirrorOf>*,!plugin-repository,!central-plugins</mirrorOf>
      <url>https://observe.fortknox.v2.prod.veedna.com/artifactory/gos-all-proxy-maven</url>
    </mirror>
  </mirrors>
  <!--  Create a build profile for Lineaje server -->
  <profiles>
    <profile>
      <id>lineaje-fortknox-profile</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <repositories>
        <repository>
          <id>lineaje-fortknox-artifactory</id>
          <url>https://observe.fortknox.commercialdev.dev.veedna.com/artifactory/gos-all-proxy-maven</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>
      <!--  Go to mavencentral for plugins -->
      <pluginRepositories>
        <pluginRepository>
          <id>central-plugins</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <!--  Make the lineaje fortknox profile as the active profile -->
  <activeProfiles>
    <activeProfile>lineaje-fortknox-profile</activeProfile>
  </activeProfiles>
</settings>
